{
  "name": "solidshmolid",
  "description": "Solid pods that live in storage you already own",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p worker/tsconfig.json --noEmit && tsc -p worker/tests/tsconfig.json --noEmit",
    "test": "vitest run --root worker",
    "dev": "wrangler dev --config wrangler.dev.jsonc"
  },
  "dependencies": {
    "@clerk/backend": "3.26.1",
    "jose": "6.2.12",
    "jsonld-streaming-parser": "5.0.1",
    "jsonld-streaming-serializer": "4.0.0",
    "mime-types": "2.1.35",
    "n3": "1.26.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261008.1",
    "@phosphor-icons/core": "2.1.1",
    "@types/mime-types": "2.1.4",
    "@types/n3": "1.26.4",
    "@types/node": "26.6.4",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "wrangler": "4.146.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true,
    "fsevents": false
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
